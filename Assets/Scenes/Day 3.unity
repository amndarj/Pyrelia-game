  dialogueUI: {fileID: 1265615261}
  mcName: MC
  mcPortrait: {fileID: -2311659948842064771, guid: d70274627a7564040b4e998e2a2fe515, type: 3}
  openingDialogueLines:
  - characterName: bocil
    dialogueText: kak sini main petasan bareng aku!
    portrait: {fileID: -2161784467561209595, guid: bf688795543eb414789175c6c5f1187e, type: 3}
    side: 0
  - characterName: Mc
    dialogueText: 'adik kecil kenapa main petasan disini?

'
    portrait: {fileID: -2311659948842064771, guid: d70274627a7564040b4e998e2a2fe515, type: 3}
    side: 1
  educationDialogueLines:
  - characterName: Mc
    dialogueText: dik jangan main petasan di sini lagi ya? karena bisa menyebabkan
      kebakaran.
    portrait: {fileID: -2311659948842064771, guid: d70274627a7564040b4e998e2a2fe515, type: 3}
    side: 1
  - characterName: Mc
    dialogueText: di area hutan sini banyak rumput dan daun daun kering, mudah memicu
      terjadinya kebakaran.
    portrait: {fileID: -2311659948842064771, guid: d70274627a7564040b4e998e2a2fe515, type: 3}
    side: 1
  closingDialogueLines:
  - characterName: Bocil
    dialogueText: jadi begitu ya kan. lain kali aku tidak akan mengulanginya lagi!!!!
    portrait: {fileID: -2161784467561209595, guid: bf688795543eb414789175c6c5f1187e, type: 3}
    side: 0
  - characterName: Mc
    dialogueText: anak pintar!!!!
    portrait: {fileID: -2311659948842064771, guid: d70274627a7564040b4e998e2a2fe515, type: 3}
    side: 1
