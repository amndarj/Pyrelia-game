  m_Script: {fileID: 11500000, guid: 9fe2020151d604b05af8da0e4d85cf07, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCMaskerInteractable
  npcName: Budi
  dialogueUI: {fileID: 148692859}
  dialogueLines:
  - Wah, asapnya tebal juga, ya. Jalan sebentar aja rasanya kayak habis bakar sate.
  - Kalau begini terus, bisa-bisa batuk Bapak nggak berhenti-berhenti.
  - Waduh, jangan sampai Pak. Oh iya ini saya bawakan masker.
  - Wahh terimaksaih semoga keadaan desa segera pulih kembali yaa.
  playerName: Aku
  playerPortrait: {fileID: -2311659948842064771, guid: ea3efa1ed1c3c8e4eb0b52bf879734e5, type: 3}
